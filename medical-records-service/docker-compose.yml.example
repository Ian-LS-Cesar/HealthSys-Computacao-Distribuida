services:
  mongodb:
    image: mongo:latest
    container_name: medical-records-service-db
    ports:
      - "27017:27017"
    environment:
      - MONGO_INITDB_ROOT_USERNAME=admin
      - MONGO_INITDB_ROOT_PASSWORD=password
    volumes:
      - mongodb_data:/data/db
    networks:
      - internal

  # Opcional: Interface visual para o Mongo
  mongo-express:
    image: mongo-express
    container_name: mongo_express_gui
    restart: always
    ports:
      - "8091:8091"
    environment:
      - ME_CONFIG_MONGODB_ADMINUSERNAME=admin
      - ME_CONFIG_MONGODB_ADMINPASSWORD=password
      # Ajustado para usar o container_name correto como hostname
      - ME_CONFIG_MONGODB_URL=mongodb://admin:password@medical-records-service-db:27017/
    networks:
      - internal

volumes:
  mongodb_data:

networks:
  internal:
    external: true
    name: healthsys-internal